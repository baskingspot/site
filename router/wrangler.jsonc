{
  "name": "baskingspot-dev",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    // Named so the Worker can fetch the front page itself. Without this the
    // binding is absent, and `/` is a 500.
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    // The front page is an asset, and assets answer before the Worker runs.
    // This is the only path the Worker needs to see, so it can send the
    // markdown twin to an agent that asks for markdown.
    "run_worker_first": ["/", "/index.html"],
  },
  "services": [
    { "binding": "SITE_STDX", "service": "baskingspot-dev-stdx" },
    { "binding": "SITE_COMPRESS", "service": "baskingspot-dev-compress" },
  ],
}
