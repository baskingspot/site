{
  "name": "baskingspot-dev",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    // Named so the Worker can fetch the front page itself. Without this the
    // binding is absent, and `/` is a 500.
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    // The front page is an asset, and assets answer before the Worker runs.
    // The landing page is named so it can negotiate markdown; `*.md` is named
    // so a direct fetch of a twin is marked noindex, which the asset layer
    // cannot do. Everything else is a site behind a service binding.
    "run_worker_first": ["/", "/index.html", "/index.md", "/*.md"],
  },
  "services": [
    { "binding": "SITE_STDX", "service": "baskingspot-dev-stdx" },
    { "binding": "SITE_COMPRESS", "service": "baskingspot-dev-compress" },
  ],
}
